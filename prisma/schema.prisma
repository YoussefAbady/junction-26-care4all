generator client {
  provider = "prisma-client"
  output = "../src/generated/prisma"
}
datasource db {
  provider = "postgresql"
}
model DemoSession {
  id        String   @id
  expiresAt DateTime
  revision  Int      @default(0)
  state     Json
  @@index([expiresAt])
}
model DemoFixture {
  id      String @id
  payload Json
}

model ScreeningAccount {
  username String @id
  password String
  language String @default("en")
  logins ScreeningLogin[]
  survey ScreeningSurvey?
  observations HealthObservation[]
  chatSymptomDraft ChatSymptomDraft?
  profile CareProfile?
  reminders CareReminder[]
  reports ContentReport[]
  interview AiInterview?
  riskAssessment RiskAssessment?
  monitors SymptomMonitor[]
}
model ScreeningLogin {
  id String @id
  username String
  expiresAt DateTime
  account ScreeningAccount @relation(fields: [username], references: [username], onDelete: Cascade)
  @@index([username])
  @@index([expiresAt])
}

model ScreeningSurvey {
  username String @id
  progress Json
  revision Int @default(0)
  legacyProgress Json?
  account ScreeningAccount @relation(fields: [username], references: [username], onDelete: Cascade)
}

model HealthObservation {
  id String @id
  username String
  kind String
  label String
  notes String
  details Json?
  observedAt DateTime?
  createdAt DateTime @default(now())
  account ScreeningAccount @relation(fields: [username], references: [username], onDelete: Cascade)
  /// The close monitoring of this symptom note, when it has one.
  monitor SymptomMonitor?
  @@index([username, createdAt, id])
}

model CareProfile {
  username String @id
  profile Json
  preferences Json
  account ScreeningAccount @relation(fields: [username], references: [username], onDelete: Cascade)
}

model CareReminder {
  id String @id
  username String
  kind String
  topic String?
  dueAt DateTime
  done Boolean @default(false)
  createdAt DateTime @default(now())
  /// The close monitoring this reminder belongs to (kind recheck): the one active reminder of a watch. Null for every other reminder.
  monitorId String?
  account ScreeningAccount @relation(fields: [username], references: [username], onDelete: Cascade)
  monitor SymptomMonitor? @relation(fields: [monitorId], references: [id], onDelete: Cascade)
  @@index([username, dueAt, id])
  @@index([monitorId])
}

/// A problem a person reported with the content. Account data, not content: the content seed never touches it.
model ContentReport {
  id String @id
  username String
  topic String?
  message String
  createdAt DateTime @default(now())
  account ScreeningAccount @relation(fields: [username], references: [username], onDelete: Cascade)
  @@index([username, createdAt])
}

model ChatSymptomDraft {
  id String @id
  username String @unique
  data Json
  revision Int @default(0)
  account ScreeningAccount @relation(fields: [username], references: [username], onDelete: Cascade)
}

// ---------------------------------------------------------------------------------------------------------------
// Design v2 (docs/design-v2.md, section 10, and Appendix A for the values each column holds). These are account data,
// not content: they belong to one account, are deleted with it and are part of its data export.
// ---------------------------------------------------------------------------------------------------------------

/// The AI interview of an account: after the basic questions a model asks one question at a time (docs/design-v2.md
/// section 5). One per account. The questions asked and the answers given, in order, are its turns.
model AiInterview {
  id          String    @id @default(uuid())
  username    String    @unique
  account     ScreeningAccount @relation(fields: [username], references: [username], onDelete: Cascade)
  /// en or fi: the language the interview is held in.
  language    String
  /// active or complete.
  status      String    @default("active")
  startedAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  completedAt DateTime?
  turns       AiTurn[]
}

/// One question of an interview and, once the person has answered, the answer.
model AiTurn {
  id          String    @id @default(uuid())
  interviewId String
  interview   AiInterview @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  /// 1, 2, 3, ... in the order the questions were asked. The turn without answeredAt is the open question.
  position    Int
  /// A ContentAssessmentDomain id: what the question finds out.
  domain      String
  /// choice, multi or number.
  kind        String
  title       String
  help        String?
  /// [{ id, label, exclusive? }] for choice and multi, in the language of the interview. The ids are the server's: o1, o2, ...
  options     Json?
  /// { min, max, unit?, decimals? } for number.
  range       Json?
  /// model, or bank for the question that comes from the database when the model cannot be used.
  source      String
  provider    String?
  model       String?
  /// { value } (an option id, a list of option ids or a number) or { marker } ("unsure" or "declined"). Null while the turn is open.
  answer      Json?
  /// The answer as words, in the language of the interview. This is what a model is told, never the ids.
  answerLabel String?
  askedAt     DateTime  @default(now())
  answeredAt  DateTime?
  @@unique([interviewId, position])
}

/// The AI risk assessment of an account (docs/design-v2.md section 6). One per account, replaced by every run.
model RiskAssessment {
  id             String    @id @default(uuid())
  username       String    @unique
  account        ScreeningAccount @relation(fields: [username], references: [username], onDelete: Cascade)
  /// running, complete or failed.
  status         String
  /// en or fi.
  language       String
  /// A hash of the facts, the interview transcript, the content version and the language it was made from. It decides `stale`.
  inputHash      String
  contentVersion String
  /// The RiskResult of section 6.1, once complete.
  result         Json?
  /// { done, total } while running.
  progress       Json?
  /// A reason code when the status is failed.
  failure        String?
  provider       String?
  model          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  completedAt    DateTime?
}

/// Close monitoring of one symptom note that was not sent to a doctor (docs/design-v2.md section 7). One per observation.
model SymptomMonitor {
  id            String    @id @default(uuid())
  username      String
  account       ScreeningAccount @relation(fields: [username], references: [username], onDelete: Cascade)
  observationId String    @unique
  observation   HealthObservation @relation(fields: [observationId], references: [id], onDelete: Cascade)
  /// active, resolved (it went away), escalated (see a doctor) or stopped (the person stopped it).
  status        String    @default("active")
  startedAt     DateTime  @default(now())
  /// When the next update is due.
  dueAt         DateTime
  /// How strong the symptom was when the watch started, 0 to 10, when that was known.
  level0        Int?
  /// How the symptom had changed when the watch started (the note's course: same, worse, better, comes or unsure).
  trend0        String?
  checkins      MonitorCheckin[]
  reminders     CareReminder[]
  @@index([username, status])
}

/// One update the person logged while watching a symptom, with what the rules made of it.
model MonitorCheckin {
  id        String   @id @default(uuid())
  monitorId String
  monitor   SymptomMonitor @relation(fields: [monitorId], references: [id], onDelete: Cascade)
  ts        DateTime @default(now())
  /// gone, better, same or worse, compared with last time.
  trend     String
  /// How strong it is now, 0 to 10, when the person said.
  level     Int?
  /// ContentMonitorFlag ids of what is new since last time.
  flags     String[]
  /// The person said something serious is happening right now.
  serious   Boolean  @default(false)
  /// What the rules said: gone, watch, doctor or emergency.
  result    String
  @@index([monitorId, ts])
}

// ---------------------------------------------------------------------------------------------------------------
// Public educational content. It holds no personal data and is the same for everyone. docs/content-database.md
// explains how it is seeded, served and edited. The Content* tables below are replaced as a whole by the seed when the
// seed input changes (ContentReport above is not one of them).
//
// Conventions: `position` keeps the order the interface shows. Lists of text and lists of source ids are text[]
// columns. Small ordered lists of objects that are always read whole are jsonb. A *SourceIds column holds ContentSource
// ids, in the order the interface shows them. The seed checks every one of those ids.
// ---------------------------------------------------------------------------------------------------------------

/// Single values: contentVersion, contentRevision, retrieved, designSource, year, example, statsNote, statsSourceIds,
/// triageIntro, triageSourceIds and catalogVersion. Design v2 adds interviewLimits, riskRubric, riskInFinland,
/// monitorRules and finnishReview (docs/design-v2.md Appendix A gives the JSON of each).
model ContentMeta {
  key   String @id
  value Json
}

/// An official page the content cites. `listed` marks the sources the PWA shows in its own source list. The others are
/// cited only by the backend's catalog and chat answers.
model ContentSource {
  id           String  @id
  listed       Boolean
  position     Int
  organisation String
  name         String
  /// Finnish title, when the source has one (the backend catalog does). Otherwise `name` is used in every language.
  nameFi       String?
  url          String
  /// The publisher's own date label, such as "Last reviewed 14 Oct 2026". Empty when the page shows none.
  published    String
  /// ISO date the page was read, for example 2026-11-14.
  retrieved    String
  /// What this source is cited for.
  use          String
  /// Language of the page itself, such as en or fi.
  language     String
  /// finland, europe or international, by the host of the page. Null when the host is not one AI answers may cite.
  tier         String?
  /// True for the sources that a risk statement, a guideline list, a factor tip, the risk rubric or riskInFinland names (design v2, 57 today).
  guideline    Boolean @default(false)
  @@index([listed, position])
}

/// Interface text. scope is copy (the English D.COPY lines), i18n (D.I18N, one row per language), catalog (the notice
/// the catalog API shows), or risk, monitor or interview (design v2: the screen copy that is content, one row per language).
model ContentString {
  scope    String
  key      String
  language String
  position Int
  text     String
  @@id([scope, key, language])
  @@index([scope, position])
}

model ContentCounty {
  id       String @id
  position Int
  name     String
}

model ContentArticle {
  id       String  @id
  position Int
  /// A topic id, or general for articles that belong to no topic.
  topic    String
  minutes  Int
  title    String
  inShort  String
  /// True for the article that introduces a topic.
  about    Boolean @default(false)
  /// Article ids to read next.
  related  String[]
  sections ContentArticleSection[]
}

model ContentArticleSection {
  articleId  String
  position   Int
  /// The section's id inside its article, such as does.
  key        String
  heading    String
  lead       String?
  paragraphs String[]
  /// The plain-language version of the paragraphs. Empty when the section has none.
  plain      String[]
  /// Bullet points, in order. Empty when the section has none.
  list       String[]
  steps      String[]
  /// [{ n, prefix, suffix, text, label }]: figures shown big, each with a label.
  stats      Json?
  /// [{ label, text }]: side-by-side columns.
  cols       Json?
  /// { topic, anchor, label }: a button into the topic page.
  link       Json?
  sourceIds  String[]
  article    ContentArticle @relation(fields: [articleId], references: [id], onDelete: Cascade)
  @@id([articleId, position])
  @@unique([articleId, key])
}

model ContentTopic {
  id                   String   @id
  /// Order of the topic list (D.TOPIC_ORDER).
  position             Int
  name                 String
  kicker               String
  /// Part of Finland's national screening programme. D.NATIONAL lists these topics, in topic order.
  national             Boolean
  pref                 String?
  blurb                String
  lede                 String
  leadSourceIds        String[]
  programme            String
  /// Article ids, in reading order.
  articleIds           String[]
  organ                String
  aboutId              String
  screeningText        String
  screeningSourceIds   String[]
  screenName           String?
  symptomsTitle        String
  symptomsSee          String
  symptomsSeeSourceIds String[]
  symptomsNote         String
  symptomsContact      String
  symptomsSourceIds    String[]
  symptoms             ContentSymptom[]
  guide                ContentGuide?
  kit                  ContentKit?
}

model ContentSymptom {
  topicId  String
  position Int
  title    String
  what     String
  /// Name of the illustration.
  art      String
  sourceId String
  topic    ContentTopic @relation(fields: [topicId], references: [id], onDelete: Cascade)
  @@id([topicId, position])
}

/// The self-check guide of a topic (TOPICS.<id>.check).
model ContentGuide {
  topicId         String   @id
  title           String
  text            String[]
  normal          String[]
  normalSourceIds String[]
  found           String
  /// [{ url, org, title, lang, length }]
  videos          Json
  differ          String
  differSourceIds String[]
  /// [{ letter, word, t, src }] for the skin guide, null for the others.
  abcde           Json?
  sourceIds       String[]
  topic           ContentTopic @relation(fields: [topicId], references: [id], onDelete: Cascade)
  steps           ContentGuideStep[]
}

model ContentGuideStep {
  topicId  String
  position Int
  heading  String
  text     String
  /// Name of the illustration.
  art      String
  sourceId String
  /// What to look for in this step.
  look     String?
  /// STEP_HINTS: how to stand or sit, and what to do with your hands.
  pose     String
  move     String
  guide    ContentGuide @relation(fields: [topicId], references: [topicId], onDelete: Cascade)
  @@id([topicId, position])
}

/// The home test kit of a topic (TOPICS.<id>.kit).
model ContentKit {
  topicId   String   @id
  title     String
  text      String
  sourceIds String[]
  kind      String
  /// { url, org, title, lang, length }
  video     Json?
  topic     ContentTopic @relation(fields: [topicId], references: [id], onDelete: Cascade)
}

/// How a national screening works, step by step (D.JOURNEYS). The id is a topic id.
model ContentJourney {
  id        String   @id
  position  Int
  intro     String
  benefits  String[]
  downsides String[]
  unsure    String
  sourceIds String[]
  steps     ContentJourneyStep[]
}

model ContentJourneyStep {
  journeyId String
  position  Int
  heading   String
  text      String
  /// Name of the illustration.
  art       String
  sourceId  String
  tip       String?
  journey   ContentJourney @relation(fields: [journeyId], references: [id], onDelete: Cascade)
  @@id([journeyId, position])
}

/// How often to do a self-check, and how long it takes (D.CHECK_META). The id is a topic id.
model ContentCheck {
  id                      String   @id
  position                Int
  name                    String
  minutes                 Int
  everyDays               Int
  /// Reminder offset the interface offers, such as 4w or 6m.
  remindIn                String
  short                   String
  frequency               String
  recommendation          String
  recommendationSourceIds String[]
  drawingSourceIds        String[]
  note                    String
}

/// A regular scan or test (D.SCANS).
model ContentScan {
  id            String   @id
  position      Int
  name          String
  topic         String
  /// invited, doctor or notnational.
  kind          String
  sex           String?
  type          String
  who           String
  /// Years between tests. 0 when there is no routine schedule.
  everyYears    Int
  frequency     String
  duration      String
  place         String
  what          String
  note          String
  /// The intake question that records when the person last had this test.
  intakeQuestion String?
  /// How the answers to that question read: { recent, long, never } or { done, kit, none }.
  intakeAnswers Json?
  journeyId     String?
  sourceIds     String[]
}

/// A national screening programme in one line each (D.NAT). The id is a topic id.
model ContentProgramme {
  id        String @id
  position  Int
  kind      String
  test      String
  ages      String
  frequency String
  scanId    String
  pick      String
}

/// Cancer figures for Finland (D.STATS). The id is a topic id.
model ContentStat {
  id          String   @id
  position    Int
  site        String
  /// Chance of being diagnosed before age 75, in percent.
  riskPercent Float
  sex         String?
  casesBoth   Int
  casesMen    Int?
  casesWomen  Int?
  /// Share of all cancers in men or in women, in percent.
  shareMen    Float?
  shareWomen  Float?
  /// Sources of this figure when they differ from the list in ContentMeta (statsSourceIds).
  sourceIds   String[]
}

model ContentVaccine {
  id        String   @id
  position  Int
  name      String
  protects  String
  finland   String?
  sourceIds String[]
}

model ContentTriageRule {
  position  Int      @id
  heading   String
  text      String
  sourceIds String[]
}

model ContentFaq {
  position     Int      @id
  topic        String?
  /// Pattern that recognises the question, with its flags. The keywords below are the fallback.
  pattern      String?
  patternFlags String?
  keywords     String[]
  question     String
  answer       String
  sourceIds    String[]
}

/// Starter questions. topic is a topic id, or general. position runs over all rows, so it keeps the group order too.
model ContentSuggestion {
  position Int    @id
  topic    String
  question String
}

/// One cancer topic of the backend catalog behind /api/cancers and /api/library, in English and Finnish.
model ContentCatalogCard {
  slug      String   @id
  position  Int
  nameEn    String
  nameFi    String
  summaryEn String
  summaryFi String
  /// ContentSource ids of official provider pages the library shows beside the card.
  linkIds   String[]
  sections  ContentCatalogSection[]
}

model ContentCatalogSection {
  cardSlug  String
  /// awareness, symptoms, selfExamination, homeKit or riskFactors.
  key       String
  position  Int
  titleEn   String
  titleFi   String
  /// awareness_only, unavailable or programme_information. Null for plain information.
  status    String?
  /// itemsEn and itemsFi are the same list in two languages.
  itemsEn   String[]
  itemsFi   String[]
  sourceIds String[]
  card      ContentCatalogCard @relation(fields: [cardSlug], references: [slug], onDelete: Cascade)
  @@id([cardSlug, key])
}

/// The passages chat answers quote. id is the passage id the API returns. A passage can have a text per language and,
/// where the answer depends on it, per residence. Several candidates for one passage are ranked by source tier.
model ContentEvidence {
  id        String
  language  String
  /// any, finland or abroad.
  residence String
  position  Int
  /// A topic id, or general.
  topic     String
  heading   String?
  text      String
  sourceIds String[]
  @@id([id, language, residence, position])
}

// ---------------------------------------------------------------------------------------------------------------
// Design v2 content (docs/design-v2.md section 9 and Appendix A). Bilingual text is two columns, nameEn and nameFi, and a
// list of text is two text[] columns of the same length. Nested data that is always read whole is jsonb with { en, fi }
// leaves. Every text has both languages; the Finnish is a draft until its ContentMeta.finnishReview entry says reviewed.
// ---------------------------------------------------------------------------------------------------------------

/// One cancer type the risk assessment rates (RULES in the design's risk script). The id is a ContentTopic id.
model ContentRiskType {
  id           String   @id
  /// Order of the cancer types in the risk overview (ORDER in the design).
  position     Int
  /// any, female or male: the sex a profile must have for the type to apply.
  sex          String
  /// The full name of the cancer type, such as Lung cancer and Keuhkosyöpä.
  nameEn       String
  nameFi       String
  /// What the questions cannot cover, copied into every assessment (RULES[type].not). The two lists are the same length.
  notCoveredEn String[]
  notCoveredFi String[]
  facts        ContentRiskFact[]
  guideline    ContentGuideline?
}

/// One factor the risk rules know (a key of LIB in the design's risk script).
model ContentRiskFactor {
  key          String   @id
  /// Order of LIB.
  position     Int
  nameEn       String
  nameFi       String
  /// A short phrase for use inside a sentence, such as smoking (SHORT in the design).
  shortEn      String
  shortFi      String
  /// What can help. Null for the age factor, which has no tip. Both languages are null together.
  tipEn        String?
  tipFi        String?
  /// Sources that state the tip. Usually empty: the tip is then advice without a citation, and no passage is built for it.
  tipSourceIds String[]
  /// [{ id, you: { en, fi } }]: the states the factor can be in, in order, each with the sentence that says it about the person.
  states       Json
  facts        ContentRiskFact[]
}

/// One statement of the risk rules, for a cancer type, a factor and a state of that factor, with the sources behind it.
model ContentRiskFact {
  riskType  String
  factor    String
  state     String
  /// Order inside the cancer type.
  position  Int
  /// How large the effect is: small, moderate, large, very-large, protective or info (from the design's weight).
  effect    String
  textEn    String
  textFi    String
  /// ContentSource ids, in display order.
  sourceIds String[]
  riskTypeRow   ContentRiskType   @relation(fields: [riskType], references: [id], onDelete: Cascade)
  riskFactorRow ContentRiskFactor @relation(fields: [factor], references: [key], onDelete: Cascade)
  @@id([riskType, factor, state])
  @@unique([riskType, position])
}

/// The guideline sources of a cancer type in priority order: Finnish first, then European, then international.
model ContentGuideline {
  riskType  String   @id
  sourceIds String[]
  riskTypeRow ContentRiskType @relation(fields: [riskType], references: [id], onDelete: Cascade)
}

/// One thing the AI interview must find out, and the question the server asks when the model cannot (the bank).
model ContentAssessmentDomain {
  id        String  @id
  /// The order the coverage list shows, and the bank asks in.
  position  Int
  nameEn    String
  nameFi    String
  /// The interview cannot finish before every essential domain that applies to the person is covered.
  essential Boolean
  /// any, female or male.
  appliesTo String
  /// The domain applies from this age in years. Null: no lower limit.
  minAge    Int?
  /// The domain applies up to this age in years. Null: no upper limit.
  maxAge    Int?
  /// What to find out, in English. The model is told this text.
  ask       String
  /// { en, fi }: a complete question for the bank, { kind, title, help?, options?: [{ label, exclusive? }], number?: { min, max, unit?, decimals? } }.
  fallback  Json
}

/// A check-in flag of close monitoring, and the wording of the "something serious right now" checkbox.
model ContentMonitorFlag {
  id       String @id
  position Int
  /// flag, or serious for the one row that holds the serious-now wording.
  kind     String
  labelEn  String
  labelFi  String
  /// The words used inside sentences and in the doctor PDF (FLAG_WORD in the design). Null for serious.
  wordEn   String?
  wordFi   String?
}

/// Every quotable passage of the content above, in plain text, for retrieval. Rebuilt from the tables whenever the
/// content is replaced or reindexed. `search` is a generated tsvector with a GIN index, both created in the migration.
model ContentPassage {
  id        String   @id
  kind      String
  /// A topic id, or general.
  topic     String
  language  String
  heading   String
  text      String
  sourceIds String[]
  search    Unsupported("tsvector")?
  @@index([language, topic])
  @@index([search], type: Gin)
}
