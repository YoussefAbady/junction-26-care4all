generator client {
  provider = "prisma-client"
  output = "../src/generated/prisma"
}
datasource db {
  provider = "postgresql"
}
model DemoSession {
  id        String   @id
  expiresAt DateTime
  revision  Int      @default(0)
  state     Json
  @@index([expiresAt])
}
model DemoFixture {
  id      String @id
  payload Json
}
