+/* ---------- Polish: phone chrome, profile card, stat card, press states, entrance ---------- */
+.statusbar, .homebar { display: none; }
+@media (min-width: 600px) and (min-height: 660px) {
+  .statusbar { display: flex; position: absolute; z-index: 100; top: 0; left: 0; right: 0; height: 54px; padding: 17px 30px 0 34px; align-items: flex-start; justify-content: space-between; font-size: .9375rem; font-weight: 700; letter-spacing: -.01em; color: var(--ink); pointer-events: none; transition: color .25s; }
+  .statusbar .island { position: absolute; left: 50%; top: 11px; width: 106px; height: 31px; margin-left: -53px; border-radius: 16px; background: #000; }
+  .statusbar .sb-r { display: flex; align-items: center; gap: 5px; }
+  .homebar { display: block; position: absolute; z-index: 100; bottom: 8px; left: 50%; width: 134px; height: 5px; margin-left: -67px; border-radius: 3px; background: var(--ink); opacity: .88; pointer-events: none; transition: background-color .25s; }
+}
+.device:has(.screen.hero:not([inert]) .nav:not([data-solid])) .statusbar { color: #fff; }
+
+/* profile card */
+.me-card { position: relative; overflow: hidden; display: flex; flex-direction: column; gap: 16px; padding: 18px 14px 14px 16px; border-radius: 26px; background: var(--panel); color: var(--panel-ink); }
+.me-card::before { content: ""; position: absolute; right: -50px; top: -60px; width: 190px; height: 190px; border-radius: 50%; background: radial-gradient(closest-side, rgba(245, 129, 32, .38), transparent); pointer-events: none; }
+.me-top { position: relative; display: flex; align-items: center; gap: 14px; }
+.me-card .avatar-lg { width: 62px; height: 62px; font-size: 1.5rem; box-shadow: 0 0 0 4px rgba(255, 255, 255, .14); }
+.me-id { flex: 1; min-width: 0; }
+.me-id .h2 { color: var(--panel-ink); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
+.me-id p { margin-top: 2px; font-size: .9375rem; color: var(--panel-ink3); }
+.me-edit { flex: none; width: 44px; height: 44px; border-radius: 50%; display: grid; place-items: center; background: var(--panel-fill); color: var(--panel-ink); transition: transform .15s var(--spring), background-color .15s; }
+.me-edit:active { transform: scale(.9); background: var(--panel-line); }
+.me-stats { position: relative; display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; }
+.me-stats a { display: flex; flex-direction: column; justify-content: center; min-height: 60px; padding: 10px 12px; border-radius: 16px; background: var(--panel-fill); transition: transform .15s var(--spring), background-color .15s; }
+.me-stats a:active { transform: scale(.96); background: var(--panel-line); }
+.me-stats b { font-size: 1.5rem; line-height: 1.05; font-weight: 800; letter-spacing: -.02em; }
+.me-stats span { margin-top: 2px; font-size: .8125rem; font-weight: 600; color: var(--panel-ink3); }
+
+/* how-common card: number and info on the first row, sentence under it */
+.stat-card { display: grid; grid-template-columns: 1fr auto; grid-template-areas: "n i" "t t"; align-items: center; gap: 0 8px; padding: 10px 6px 12px 16px; border-radius: 16px; }
+.stat-card .sc-n { grid-area: n; font-size: 1.1875rem; line-height: 1.2; }
+.stat-card .sc-t { grid-area: t; flex: none; margin-top: 1px; padding-right: 10px; font-size: .875rem; line-height: 1.35; }
+.stat-card .sc-i { grid-area: i; }
+
+/* native feel */
+.tab, .nav, .nav-btn, .btn, .chip, .cell, .fight-btn, .seg, .sw, .icon-btn, .chk-row, .cr, .tile { -webkit-user-select: none; user-select: none; -webkit-touch-callout: none; }
+a.cell, button.cell, .chk-row, .cr, .tile, .scn, .fu, .tl-card { transition: transform .18s var(--spring), background-color .18s, box-shadow .18s; }
+a.cell:active, button.cell:active { background: var(--fill); }
+.chk-row:active, .cr:active, .tile:active, .tl-card:active { transform: scale(.985); }
+.group > .cell:active { transform: none; }
+.tab { transition: color .2s; }
+.tab[aria-current="page"] .pill { box-shadow: 0 6px 16px -6px rgba(245, 129, 32, .7); }
+.fight-btn { transition: transform .25s var(--spring), box-shadow .25s; }
+
+/* dim the screen underneath while another slides over it */
+.screen::after { content: ""; position: absolute; inset: 0; z-index: 40; background: #000; opacity: 0; pointer-events: none; }
+
+/* content arrives with a short stagger (first view of a screen only) */
+.screen.enter .content > * { animation: enterUp .5s var(--spring) both; }
+.screen.enter .content > :nth-child(1) { animation-delay: .04s; }
+.screen.enter .content > :nth-child(2) { animation-delay: .09s; }
+.screen.enter .content > :nth-child(3) { animation-delay: .14s; }
+.screen.enter .content > :nth-child(4) { animation-delay: .19s; }
+.screen.enter .content > :nth-child(5) { animation-delay: .24s; }
+.screen.enter .content > :nth-child(6) { animation-delay: .29s; }
+.screen.enter .content > :nth-child(n+7) { animation-delay: .32s; }
+/* full-bleed heroes and the welcome picture stay put */
+.screen.enter .content > .t-hero, .screen.enter .content > .welcome-art, .screen.enter .t-hero, .screen.enter .welcome-art { animation: none; }
+@keyframes enterUp { from { opacity: 0; transform: translateY(14px); } to { opacity: 1; transform: none; } }
+
+/* headings and the screen itself take programmatic focus for screen readers; never draw a ring on them */
+.large:focus-visible, .sheet-title:focus-visible, .scroller:focus-visible, [tabindex="-1"]:focus-visible { outline: none; box-shadow: none; }
+@media (max-width: 340px) {
+  .me-stats a { padding: 10px 9px; }
+  .me-stats span { font-size: .75rem; }
+  .content { gap: 24px; }
+}
+
