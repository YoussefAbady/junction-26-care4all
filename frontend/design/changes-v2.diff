+.mon-steps li { display: inline-flex; align-items: center; min-height: 30px; padding: 0 12px; border-radius: 15px; background: var(--surface); font-size: .8125rem; font-weight: 700; color: var(--ink3); }
+.mon-steps li.on { background: var(--ok-soft); color: var(--ok); }
+.mon-steps li.on::before { content: ""; width: 10px; height: 6px; margin-right: 6px; border-left: 2.5px solid currentColor; border-bottom: 2.5px solid currentColor; transform: rotate(-45deg) translate(1px, -1px); }
+.mon-steps li.now { background: var(--ink); color: var(--bg); }
+.mon-chip { display: inline-flex; align-items: center; gap: 5px; align-self: flex-start; margin-top: 4px; min-height: 26px; padding: 0 10px; border-radius: 13px; background: var(--ai-soft); color: var(--ink); font-size: .75rem; font-weight: 700; }
