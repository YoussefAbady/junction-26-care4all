# Use the same password you set in .env.docker, URL-encoded where needed.
DATABASE_URL=postgresql://care4all:REPLACE_ME@localhost:5432/care4all
APP_ORIGIN=http://localhost:3000
COOKIE_SECURE=false
# Left over from the first demo. The assistant does not read it: CHAT_PROVIDER below chooses the model.
AI_PROVIDER=mock
# For an explicitly local, single-process demo without PostgreSQL:
# DEMO_STORE=file

# The assistant answers from the reviewed passages in the database. With CHAT_PROVIDER=catalog (the default) it shows
# those passages as they are and calls no model. Set gemini (with the key and model below) or verda (with the three
# VERDA values) and an AI model writes each answer from those passages instead. It is sent only the typed question,
# the language and public passages, never account or health records, and any failure falls back to the passages.
CHAT_PROVIDER=catalog
GEMINI_API_KEY=
GEMINI_MODEL=
VERDA_BASE_URL=https://inference.verda.com/v1
VERDA_API_KEY=
VERDA_MODEL=
# Answers a model may write per account in 10 minutes. Empty means 20.
AI_RATE_LIMIT=

# A scratch database for tests/content-db.test.ts (never the database the app uses). Each run makes its own schema in it
# and drops the schema afterwards. Without this the content database tests are skipped.
# CONTENT_TEST_DATABASE_URL=postgresql://care4all:REPLACE_ME@localhost:5432/care4all_content_test
